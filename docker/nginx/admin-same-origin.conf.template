# 同源部署新管理端（v2board-admin）的演示：模拟常见的宝塔站点配置（V2Board 伪静态 + 宝塔默认的静态文件缓存规则），
# 再加上 ../v2board-admin/DEPLOY.md 里的两段 location（这里把「后台路径」换成了 ${V2B_SECURE_PATH}）。
# nginx 官方镜像启动时用 envsubst 把 ${V2B_SECURE_PATH} 替换成环境变量的值（nginx 自己的 $uri 等变量不受影响）。
server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    index index.php index.html;
    charset utf-8;
    client_max_body_size 16m;

    # ---- DEPLOY.md 的同源部署配置（开始）----
    # 访问原来的后台地址时跳转到新管理端（相对地址跳转：在 CDN / 反向代理后面也不会跳到 http 或错误的端口）
    location = /${V2B_SECURE_PATH} {
        absolute_redirect off;
        return 302 /${V2B_SECURE_PATH}/;
    }
    # 新管理端：/后台路径/。^~ 让它优先于下面宝塔默认的 js / css 正则规则
    location ^~ /${V2B_SECURE_PATH}/ {
        alias /www/wwwroot/v2board-admin/;
        index index.html;
        # index.html、config.js：每次向服务器确认是否有更新
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow";
        # assets 下的文件名带内容哈希，可以长期缓存
        location ^~ /${V2B_SECURE_PATH}/assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Robots-Tag "noindex, nofollow";
        }
    }
    # ---- DEPLOY.md 的同源部署配置（结束）----

    # V2Board 伪静态
    location /downloads {
    }
    location / {
        try_files $uri $uri/ /index.php$is_args$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_read_timeout 120s;
    }

    # 宝塔默认的静态文件缓存规则
    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$ {
        expires 30d;
        error_log /dev/null;
        access_log /dev/null;
    }
    location ~ .*\.(js|css)?$ {
        expires 12h;
        error_log /dev/null;
        access_log /dev/null;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
