# v2b-demo 运行参数。复制为 .env 后按需修改（.env 不提交；改这里时同步改 .env）。
# 注意：这里只放 docker / 初始化用的参数，Laravel 自己的配置在 src/.env（由 init 首次生成）。

COMPOSE_PROJECT_NAME=v2board

# 对外端口：旧管理端 http://localhost:6600/<V2B_SECURE_PATH>，API http://localhost:6600/api/v1
HTTP_PORT=6600
# 监听地址：默认只允许本机访问；改成 0.0.0.0 可以让内网的其他设备（例如手机）访问，
# 此时新管理端的开发服务器也要加 --host（pnpm dev --host）。注意后台账号是开发用的弱密码，只在可信的内网里打开
HTTP_BIND=127.0.0.1

# ---- 同源部署新管理端的演示（默认不启动：docker compose --profile admin up -d --no-deps admin-nginx，见 README）----
# 新管理端 http://localhost:6601/<V2B_SECURE_PATH>/
ADMIN_HTTP_PORT=6601
# 新管理端的打包目录（相对本目录）
ADMIN_DIST=../v2board-admin/dist

# ---- V2board 源码（scripts/sync-src.sh、update.sh；默认 GitHub 上 wyx2685/v2board 的 master）----
# 固定到某个分支 / 标签 / 提交：
# V2BOARD_REF=master
# 换一个仓库（例如自己的 fork）：
# V2BOARD_REPO=https://github.com/wyx2685/v2board.git

# ---- 首次初始化写入 src/config/v2board.php 的值（文件已存在时不会覆盖）----
# 后台路径：至少 8 位，只能包含字母、数字、下划线、横线
V2B_SECURE_PATH=devadmin123
V2B_APP_NAME=V2Board
V2B_APP_URL=http://localhost:6600

# ---- 管理员账号（每次启动确保存在且 is_admin=1；密码只在首次创建时设置）----
V2B_ADMIN_EMAIL=admin@example.com
V2B_ADMIN_PASSWORD=admin123456

# 首次初始化是否写入演示数据（1 写入 / 0 不写）
V2B_SEED_DEMO=1

# ---- 公开演示站（DEMO_ENABLE=1 时 up.sh / update.sh 一并启动 demo 服务，见 README「公开演示站」）----
# 每小时整点按当前时间重新生成演示数据并写回系统配置；每 5 分钟刷新在线状态；每分钟守护后台路径等关键配置。
# 本机开发保持 0：不会每小时重置数据，也不动你自己改的配置（需要刷新数据时手动执行 ./scripts/demo-reset.sh）
DEMO_ENABLE=0
# 演示数据的天数（开站日 = 今天往前推这么多天）
DEMO_DAYS=120

# Horizon 最大进程数（写入 src/.env 的 HORIZON_MAX_PROCESSES）
V2B_HORIZON_MAX_PROCESSES=4

# ---- MySQL ----
MYSQL_DATABASE=v2board
MYSQL_USER=v2board
MYSQL_PASSWORD=v2board
MYSQL_ROOT_PASSWORD=root

# ---- PHP ----
# output_buffering：4096 与常见生产环境一致（CSV 导出超过 4KB 时跨域会丢 CORS 头，可如实暴露问题）；
# 改成足够大的字节数（例如 16777216，即 16MB），跨域导出也能拿到 CORS 头。注意要写数字：写 On 经过环境变量替换后不生效
PHP_OUTPUT_BUFFERING=4096

# ---- 镜像与软件源（网络不好时可替换）----
PHP_BASE_IMAGE=php:8.2-fpm-bookworm
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:alpine
# 构建 PHP 镜像时使用的 Debian 源主机名，留空用默认（例：mirrors.aliyun.com）
APT_MIRROR=
# composer 镜像地址，留空用 packagist.org（例：https://mirrors.aliyun.com/composer/）
V2B_COMPOSER_MIRROR=
